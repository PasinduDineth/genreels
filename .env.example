CLIENT_ORIGIN=http://localhost:5173
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# RunPod gateway/proxy used for LLM, TTS, image, and video generation.
RUNPOD_GATEWAY_BASE_URL=http://127.0.0.1:8000
RUNPOD_LLM_MODEL=qwen3:32b
RUNPOD_TTS_MODEL=tts-1
RUNPOD_TTS_VOICE_NAME=Ryan
RUNPOD_VIDEO_POLL_INTERVAL_MS=5000
RUNPOD_VIDEO_POLL_MAX_ATTEMPTS=240
RUNPOD_VIDEO_DURATION_SECONDS=6

VITE_API_BASE_URL=http://localhost:4000/api
VITE_RUNPOD_API_BASE_URL=
VITE_USE_MOCKS=false
